{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "A meeting room document",
      "type": "object",
      "properties": {
        "hostId": { "type": "string", "description": "UID of the meeting host" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the room was created" },
        "stageOverlay": {
          "type": "object",
          "description": "Live stage media/template broadcast overlay state"
        },
        "sessionCount": { "type": "number", "description": "Tracked session count for reusable rooms such as PMI rooms" },
        "archivedSessionCount": { "type": "number", "description": "Count of archived sessions beyond the rolling sessionLogs map" },
        "sessionLogs": { "type": "object", "description": "Map of tracked LiveKit room session IDs to start/lastActive timestamps" }
      },
      "required": ["hostId", "createdAt"]
    },
    "RoomSession": {
      "title": "RoomSession",
      "description": "Individual conference session instance inside a reusable room (e.g. PMI)",
      "type": "object",
      "properties": {
        "sessionSid": { "type": "string" },
        "roomId": { "type": "string" },
        "isPmi": { "type": "boolean" },
        "startedAtMs": { "type": "number" },
        "lastActiveAtMs": { "type": "number" }
      },
      "required": ["sessionSid", "roomId", "startedAtMs"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and real-time presence status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "isOnline": { "type": "boolean" },
        "status": { "type": "string", "description": "available | busy | away | in_meeting | offline" },
        "previousStatus": { "type": "string" },
        "currentRoomId": { "type": "string" },
        "inMeetingHeartbeat": { "type": "number" },
        "lastSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "status"]
    },
    "ChatTab": {
      "title": "ChatTab",
      "description": "Custom in-meeting chat tab metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message scoped to a specific in-meeting chat tab",
      "type": "object",
      "properties": {
        "tabId": { "type": "string" },
        "sender": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["tabId", "sender", "message", "timestamp"]
    },
    "AdmittedUser": {
      "title": "AdmittedUser",
      "description": "A participant admitted to a room",
      "type": "object",
      "properties": {
        "admittedAt": { "type": "string", "format": "date-time", "description": "When the user was admitted" }
      },
      "required": ["admittedAt"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "A scheduled meeting",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "roomId": { "type": "string" },
        "hostId": { "type": "string" },
        "hostEmail": { "type": "string" },
        "hostName": { "type": "string" },
        "createdBy": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "acceptedUids": { "type": "array", "items": { "type": "string" } },
        "acceptedNames": { "type": "array", "items": { "type": "string" } },
        "invitedEmails": { "type": "array", "items": { "type": "string" } },
        "coverImage": { "type": "string" },
        "recurrence": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "hostId"]
    },
    "Recording": {
      "title": "Recording",
      "description": "Saved meeting recording metadata",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "roomId": { "type": "string" },
        "sessionSid": { "type": "string" },
        "filename": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "mode": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "roomId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User calendar invite and meeting notification",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "roomId": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "read"]
    },
    "QAItem": {
      "title": "QAItem",
      "description": "Live Q&A question and optional answer",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "authorName": { "type": "string" },
        "authorId": { "type": "string" },
        "upvotes": { "type": "array", "items": { "type": "string" } },
        "answer": { "type": "string" },
        "answeredBy": { "type": "string" },
        "isAnsweredLive": { "type": "boolean" },
        "isDismissed": { "type": "boolean" }
      },
      "required": ["question", "authorId"]
    },
    "Poll": {
      "title": "Poll",
      "description": "In-meeting poll or scored quiz",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["type", "question", "options"]
    },
    "CanvasCard": {
      "title": "CanvasCard",
      "description": "Collaborative kanban card",
      "type": "object",
      "properties": {
        "columnId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "tag": { "type": "string" }
      },
      "required": ["columnId", "title"]
    },
    "StageDocumentPage": {
      "title": "StageDocumentPage",
      "description": "Paginated slide or media page shared on the live meeting stage",
      "type": "object",
      "properties": {
        "pageNumber": { "type": "number" },
        "kind": { "type": "string" },
        "imageUrl": { "type": "string" },
        "heading": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["pageNumber", "kind"]
    },
    "MeetingFeedback": {
      "title": "MeetingFeedback",
      "description": "Post-meeting participant rating and qualitative feedback",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "sessionSid": { "type": "string" },
        "meetingTitle": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "isGuest": { "type": "boolean" },
        "createdAtMs": { "type": "number" },
        "category": { "type": "string", "description": "meeting_rating | error_report" },
        "errorContext": { "type": "string", "description": "Optional error details or source screen for error reports" }
      },
      "required": ["roomId", "rating"]
    },
    "Clip": {
      "title": "Clip",
      "description": "Saved video clip metadata",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "type": { "type": "string" }
      },
      "required": ["title", "userId"]
    }
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and real-time presence status"
    },
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Meeting room metadata and stage overlay"
    },
    "/rooms/{roomId}/sessions/{sessionId}": {
      "schema": "RoomSession",
      "description": "Individual meeting session instances hosted in this room"
    },
    "/rooms/{roomId}/stageDocs/{docId}/pages/{pageNumber}": {
      "schema": "StageDocumentPage",
      "description": "Paginated document slides and stage media frames"
    },
    "/rooms/{roomId}/chatTabs/{tabId}": {
      "schema": "ChatTab",
      "description": "Custom chat tabs inside a meeting room"
    },
    "/rooms/{roomId}/chatMessages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages belonging to custom meeting chat tabs"
    },
    "/rooms/{roomId}/admitted/{userId}": {
      "schema": "AdmittedUser",
      "description": "List of admitted participants"
    },
    "/rooms/{roomId}/qa/{qaId}": {
      "schema": "QAItem",
      "description": "Meeting Q&A items"
    },
    "/rooms/{roomId}/polls/{pollId}": {
      "schema": "Poll",
      "description": "Meeting polls and quizzes"
    },
    "/rooms/{roomId}/canvas/{cardId}": {
      "schema": "CanvasCard",
      "description": "Room canvas board cards"
    },
    "/meetings/{meetingId}": {
      "schema": "Meeting",
      "description": "Scheduled meetings"
    },
    "/meetingFeedback/{feedbackId}": {
      "schema": "MeetingFeedback",
      "description": "Post-meeting ratings and feedback submissions"
    },
    "/recordings/{recordingId}": {
      "schema": "Recording",
      "description": "Saved meeting recording metadata"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User push and in-app notifications"
    },
    "/clips/{clipId}": {
      "schema": "Clip",
      "description": "Recorded clip library items"
    }
  }
}
